:80 {
	root * /srv
	file_server {
		pass_thru
	}

	try_files {path} {path}.html {path}/index.html =404

	handle_errors {
		@lang_path path_regexp lang ^/([a-z]{2})/

		handle @lang_path {
			rewrite * /{re.lang.1}/404/index.html
			# respond 404 {
			# 	body {re.lang.1}
			# }
			file_server {
				status 404
			}
		}

		handle {
			rewrite * /404.html
			file_server {
				status 404
			}
		}
	}
}